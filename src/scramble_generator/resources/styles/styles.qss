QMainWindow, QWidget#MainWindowContent {
    background-color: {{background-color}};
    color: {{color}};
}

QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
}

QPushButton:hover {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QPushButton:pressed {
    background-color: {{accent-hover-color}};
}

QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    font-weight: bold;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
}
QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
}

QComboBox, QSpinBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
}

QComboBox:hover, QSpinBox:hover {
    border: 1px solid {{accent-color}};
}

QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

QFrame#Card {
    background-color: {{surface-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: bold;
    color: {{color}};
    border: none;
    background: transparent;
    padding-bottom: 4px;
}

QCheckBox, QLabel {
    color: {{color}};
    border: none;
    background: transparent;
}

/* Checkbox uses accent-color to match PrimaryButton */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: {{border}};
    background-color: {{widget-background-color}};
}
QCheckBox::indicator:checked {
    background-color: {{accent-color}};
    border: none;
}

QLabel#ScrambleOutput {
    padding: 12px; 
    font-family: monospace;
    font-size: 16px;
}

QScrollArea#ScrambleScroll {
    background-color: {{widget-background-color}};
    border: none;
    border-radius: {{border-radius}};
}

QScrollBar:vertical {
    border: none;
    background: {{widget-background-color}};
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: {{muted-color}};
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QLabel#TimerOutput {
    background-color: {{widget-background-color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
    font-family: monospace;
    font-size: 18px;
    color: {{function-color}};
}

QMenuBar {
    background-color: {{surface-color}};
    color: {{color}};
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
}

QMenuBar::item:selected {
    background-color: {{widget-background-color}};
    color: {{color}};
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QDialog {
    background-color: {{background-color}};
    color: {{color}};
}

QToolTip {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
}

QLabel#DialogTitle {
    font-size: 22px;
    font-weight: bold;
    color: {{color}};
}

QLabel#MutedLabel {
    color: {{muted-color}};
    font-size: 14px;
}